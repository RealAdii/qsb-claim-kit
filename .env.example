AUTH_MODE=github
# postgres for staging and production. memory is local development only:
# sessions, awards and claims live in the process and vanish on restart.
STORE=postgres
APP_ORIGIN=http://127.0.0.1:4318
PORT=4318
HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
CLAIM_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://127.0.0.1:4318/auth/github/callback
# STORE=memory only: the award snapshot loaded at startup, relative to the kit root.
DEV_AWARDS_FILE=dev-awards.json
GOOGLE_SHEET_ID=REPLACE_WITH_PRIVATE_SPREADSHEET_ID
GOOGLE_SHEET_TAB=Reward claims
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
