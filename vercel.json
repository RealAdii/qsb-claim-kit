{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/claim",
      "destination": "/index.html"
    },
    {
      "source": "/claim/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/claim/claim-component.css",
      "destination": "/claim-component.css"
    },
    {
      "source": "/claim/claim.js",
      "destination": "/claim.js"
    },
    {
      "source": "/claim/live.js",
      "destination": "/live.js"
    },
    {
      "source": "/claim/leaderboard.js",
      "destination": "/leaderboard.js"
    },
    {
      "source": "/claim/media/:file*",
      "destination": "/media/:file*"
    },
    {
      "source": "/claim/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/claim/api/yukon/reward-claim",
      "destination": "/api/index"
    },
    {
      "source": "/claim/api/qsb/leaderboard",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' https://avatars.githubusercontent.com; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
