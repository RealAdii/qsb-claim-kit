{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/demo.js",
      "destination": "/live.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/qsb/rewards",
      "destination": "/index.html"
    },
    {
      "source": "/qsb/rewards/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/yukon/reward-claim",
      "destination": "/api/index"
    },
    {
      "source": "/api/qsb/leaderboard",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' https://avatars.githubusercontent.com; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
